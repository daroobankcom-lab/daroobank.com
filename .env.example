# Development template only. Copy to .env and replace every placeholder.
# The local shell does not load .env automatically; Docker Compose does.
DAROOBANK_DEBUG=1
DAROOBANK_SECRET_KEY=replace-with-a-long-random-secret
DAROOBANK_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional operational probes. Keep disabled unless access is restricted separately.
DAROOBANK_HEALTH_PROBES_ENABLED=0
# Synthetic development-only login throttle; requires maintenance of window rows.
DAROOBANK_STAFF_LOGIN_THROTTLE=0
# Non-debug only, opt in after proxy/firewall review; never trust client headers directly.
# DAROOBANK_TRUST_PROXY_SSL_HEADER=1
# DAROOBANK_TRUSTED_PROXY_CIDRS=192.0.2.10/32
POSTGRES_DB=daroobank_dev
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-unique-password
# For running Django outside Docker; Compose overrides this with its service name.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
# POSTGRES_SSLMODE=verify-full
